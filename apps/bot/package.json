{
  "name": "@mcee77/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/create-bot.d.ts",
      "import": "./dist/create-bot.js"
    },
    "./create-bot": {
      "types": "./dist/create-bot.d.ts",
      "import": "./dist/create-bot.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "dev:admin": "tsx watch src/admin-index.ts",
    "start": "node dist/index.js",
    "start:admin": "node dist/admin-index.js"
  },
  "dependencies": {
    "@mcee77/db": "*",
    "@mcee77/shared": "*",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
